+# N_m3u8DL-RE upstream bug nilaoda/N_m3u8DL-RE#594 + #409 + #443:
+# live recordings don't detect stream end and run forever even when the
+# chunklist stops growing. Chaturbate's HLS doesn't reliably emit
+# #EXT-X-ENDLIST when a stream ends, so the recorder polls the playlist
+# in vain until manually killed. Symptoms: 14 hung recorders observed
+# 2026-05-18, oldest running 11 days with output file frozen 10.9 days.
+# Watchdog: track output file mtime per recorder. If it hasn't grown
+# in HANG_SIGINT_AFTER seconds, send SIGINT (the community workaround
+# is "Ctrl+C and remux"). Escalate to SIGTERM if still alive
+# HANG_SIGTERM_AFTER seconds after the SIGINT.
+HANG_SIGINT_AFTER = 300  # 5 min of no file growth -> hang detected
+HANG_SIGTERM_AFTER = 30  # 30s for graceful exit before escalating
