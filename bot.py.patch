+    def _reap_startup_orphans(self):
+        """Container just started: any pre-existing .part.ts is by
+        definition an orphan from a prior abrupt shutdown (host
+        crash, docker kill, OOM, pre-shutdown-finalize era).
+        N_m3u8DL-RE PIDs reset on container restart so nothing
+        on disk could possibly still be holding any of these files
+        open. Rename to .ts so they're not stuck in half-named
+        state forever and Syncthing can pick them up.
+        """
+        try:
+            for root, _, files in os.walk("videos"):
+                for f in files:
+                    if not f.endswith(".part.ts"):
+                        continue
+                    src = os.path.join(root, f)
+                    dst = os.path.join(root, f[:-len(".part.ts")] + ".ts")
+                    if os.path.exists(dst):
+                        # would clobber an already-finalized file with
+                        # the same basename; very unlikely but skip
+                        self.logger.warning("Orphan skip (target exists): {}".format(src))
+                        continue
+                    os.rename(src, dst)
+                    self.logger.info("Startup-orphan finalized: {} -> {}".format(src, dst))
+        except Exception as _e:
+            self.logger.exception("Orphan reap failed: " + str(_e))
+
     def run(self):
+        # clean up .part.ts files left behind by a prior abrupt exit
+        self._reap_startup_orphans()
